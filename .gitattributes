# 换行符规范化：避免 Windows 上提交的 CRLF 破坏 Unix 脚本
* text=auto eol=lf

# Windows 批处理 / PowerShell 保持 CRLF
*.bat   text eol=crlf
*.ps1   text eol=crlf
*.cmd   text eol=crlf

# Gradle wrapper 的 shell 脚本必须是 LF，否则 macOS / Linux 上无法执行
gradlew text eol=lf

# 二进制资源不做换行转换
*.png  binary
*.jpg  binary
*.jpeg binary
*.webp binary
*.ico  binary
*.jar  binary
*.apk  binary
*.kra  binary
